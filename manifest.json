{
  "manifest_version": 3,
  "name": "AI Agent Element Selector",
  "version": "2.0.0",
  "description": "Инструмент для аннотирования, редактирования и прототипирования веб-страниц с помощью ИИ-агентов.",
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "state.js",
        "helpers.js",
        "ui.js",
        "annotations.js",
        "inspect.js",
        "edit.js",
        "templates.js",
        "init.js"
      ],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["shadow.css", "icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
