{
  "manifest_version": 3,
  "name": "AI Agent Element Selector",
  "version": "1.0.0",
  "description": "Инструмент для удобного копирования селекторов, HTML и контекста веб-элементов для ИИ-агентов.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
